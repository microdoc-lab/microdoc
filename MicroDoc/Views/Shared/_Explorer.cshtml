@model ExplorerViewModel

@if (string.IsNullOrWhiteSpace(Model.Id))
{
    throw new ArgumentNullException();
}

<div id="@Model.Id" class="explorer @Model.Domain.Name" data-domain="@Model.Domain.Name">
    <div class="tree-panel">
        @await Html.PartialAsync("_TagTree", Model.TagTree)
    </div>

    <div class="splitter"></div>

    <div class="doc-panel">
        @await Html.PartialAsync("_DocMatrix", Model.DocMatrix)
    </div>

	<div class="overlay">
	    <div class="toolbar">
			<button class="icon-button view w" title="Toggle View/Edit">
	    		<img src="/icons/View.png">
    		</button>
			<button class="icon-button delete w" title="Delete">
	    		<img src="/icons/Delete.png">
    		</button>
			<button class="icon-button close r" title="@(User.IsInRole(Model.Domain.Name + ":" + "w") ? "Save & Close" : "Close")">
	    		<img src="/icons/Close.png">
    		</button>
	    </div>
    </div>

    <div style="display:none;">
        @await Html.PartialAsync("_Doc", Model.TemplateDoc)
    </div>
</div>

<script>
    (function() {
        const container = document.getElementById("@Model.Id");
        if (!container) return;

        var options = window["@Model.Id" + "Options"]
		if (!options)
			window["@Model.Id" + "Options"] = options = {};

        const explorer = new Explorer(container, options);
        explorer.domain = "@Model.Domain.Name";
        explorer.selectedTag = "@Model.SelectedTag";
        explorer.tagTreeId = "@Model.TagTree.Id";
        explorer.docMatrixId = "@Model.DocMatrix.Id";
        explorer.templateDocId = "@Model.TemplateDoc.Id";
        
        explorer.InitBehaviors();
    })();
</script>