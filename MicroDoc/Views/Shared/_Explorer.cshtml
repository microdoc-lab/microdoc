@using MicroDoc.Services
@inject DomainOptions _domainOptions
@model ExplorerViewModel

@if (string.IsNullOrWhiteSpace(Model.Id))
{
    throw new ArgumentNullException();
}

<div id="@Model.Id" class="explorer @Model.Domain.Name" data-domain="@Model.Domain.Name">
    <div class="tree-panel">
        @await Html.PartialAsync("_TagTree", Model.TagTree)
    </div>

    <div class="splitter"></div>

    <div class="doc-panel">
        @await Html.PartialAsync("_DocMatrix", Model.DocMatrix)
    </div>

	<div class="overlay">
	    <div class="toolbar">
			<button class="icon-button print r" title="Print">
				<img src="/icons/Print.png">
			</button>
			<button class="icon-button print-image r" title="Print Image">
				<img src="/icons/PrintImage.png">
			</button>
			<button class="icon-button view w right" title="Toggle View/Edit">
	    		<img src="/icons/View.png">
    		</button>
			<button class="icon-button delete w" title="Delete">
	    		<img src="/icons/Delete.png">
    		</button>
			<button class="icon-button close r" title="@(User.IsInRole(_domainOptions, "w", Model.Domain.Name) ? "Save & Close" : "Close")">
	    		<img src="/icons/Close.png">
    		</button>
	    </div>
    </div>

    <div class="modal">
        <div class="doc-container">
            <div class="toolbar">
                <span class="title"></span>
				<button class="icon-button r" onclick='document.getElementById("@Model.Id").explorer.docMatrix().CopyPrint()' title="Copy">
					<img src="/icons/Clipboard.png">
				</button>
				<button class="icon-button r" onclick='document.getElementById("@Model.Id").explorer.docMatrix().DialogPrint(event)' title="Print">
					<img src="/icons/Print.png">
				</button>
				<button class="icon-button r" onclick='document.getElementById("@Model.Id").explorer.docMatrix().DialogPrintImages(event)' title="Print Images">
					<img src="/icons/PrintImage.png">
				</button>
			    <button class="icon-button close r" onclick='document.getElementById("@Model.Id").explorer.docMatrix().ClosePrint()' title="Close">
	    		    <img src="/icons/Close.png">
    		    </button>
            </div>
            <div class="scroll-area print">
            </div>
        </div>
    </div>

    <div style="display:none;">
        @await Html.PartialAsync("_Doc", Model.TemplateDoc)
    </div>
</div>

<script>
    (function() {
        const container = document.getElementById("@Html.Raw(Model.Id)");
        if (!container) return;

        var options = window["@Html.Raw(Model.Id)" + "Options"]
		if (!options)
			window["@Html.Raw(Model.Id)" + "Options"] = options = {};

        const explorer = GetInstanceOrCreate(container.parentElement, () => new Explorer(container, options));
        explorer.domain = "@Html.Raw(Model.Domain.Name)";
        explorer.selectedTag = "@Html.Raw(Model.SelectedTag)";
        explorer.tagTreeId = "@Html.Raw(Model.TagTree.Id)";
        explorer.docMatrixId = "@Html.Raw(Model.DocMatrix.Id)";
        explorer.templateDocId = "@Html.Raw(Model.TemplateDoc.Id)";
        
        explorer.UpdateElement(container);
        explorer.InitBehaviors();
    })();
</script>