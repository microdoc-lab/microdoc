@model ExplorerViewModel

@if (string.IsNullOrWhiteSpace(Model.Id))
{
    throw new ArgumentNullException();
}

<div id="@Model.Id" class="explorer">
    <div class="tree-panel">
        @await Html.PartialAsync("_TagTree", Model.TagTree)
    </div>

    <div class="splitter"></div>

    <div class="doc-panel">
        @await Html.PartialAsync("_DocMatrix", Model.DocMatrix)
    </div>
</div>

<script>
    (function() {
        const container = document.getElementById("@Model.Id");
        if (!container) return;

        const options = window["@Model.Id" + "Options"]

        const explorer = new Explorer(container, options);
        explorer.domain = "@Model.Domain.Name";
        explorer.tagTreeId = "@Model.TagTree.Id";
        explorer.docMatrixId = "@Model.DocMatrix.Id";
        
        explorer.InitBehaviors();
    })();
</script>