@using MicroDoc.Services
@inject DomainOptions _domainOptions

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MicroDoc</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/TagTree.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/TagTree_Search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/TagTree_Selection.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/TagTree_Toggle.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/DocMatrix.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/DocMatrix_Search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/DocMatrix_Preview.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/DocMatrix_Print.css" asp-append-version="true" />
    
    <link rel="stylesheet" href="~/css/Doc_Shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Doc.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/Explorer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Explorer_Resize.css" asp-append-version="true" />
    
    <link rel="stylesheet" href="~/css/Domain.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Domain_Options.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Domain_Features.css" asp-append-version="true" />
</head>
<body>
    <header>
        @await Html.PartialAsync("_Security")

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand landing-page-link" href="" onclick='window.domain.ShowLandingPage(); return false;'>MicroDoc</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity.IsAuthenticated)
                        foreach (var domain in _domainOptions.Domains.Where(d => User.IsInRole(_domainOptions, "r", d.Name)))
                        {
                        <li class="nav-item">
                            <a class="nav-link text-dark explorer-link" href="" onclick='window.domain.OpenExplorer("@domain.Name"); return false;' data-domain="@domain.Name">@domain.Name</a>
                        </li>
                        }
                        @if (User.IsInRole("a"))
                        {
                        <li class="nav-item a">
                            <a class="nav-link text-dark" href="" onclick='window.domain.ToggleDomainOptions(); return false;' data-loc-title="Header_EditDomainOptions">
                                <img src="/icons/Settings.png">
                            </a>
                        </li>
                        }
                    </ul>

                    <div class="lang-links me-3">
                        @await Html.PartialAsync("_Lang")
                    </div>
                    <div class="auth-links">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span data-loc-content="Auth_Greeting" data-loc-content$0="@User.Identity.Name"></span>
                            <a class="btn btn-outline-secondary btn-sm ms-2" href="/Home/Logout" data-loc-content="Auth_Logout"></a>
                        }
                        else
                        {
                            if (_domainOptions.SimpleLogin)
                            {
                            <a class="btn btn-primary btn-sm" href="" onclick='SimpleLogin(); return false;' data-loc-content="Auth_LoginSimple"></a>
                            }
                            <a class="btn btn-primary btn-sm" href="/Home/Login" data-loc-content="Auth_LoginGoogle"></a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <script src="~/js/DocParser.js" asp-append-version="true"></script>

    <script src="~/js/TagTree.js" asp-append-version="true"></script>
    <script src="~/js/TagTree_TagChanges.js" asp-append-version="true"></script>
    <script src="~/js/TagTree_Reorder.js" asp-append-version="true"></script>
    <script src="~/js/TagTree_DragMove.js" asp-append-version="true"></script>
    <script src="~/js/TagTree_Selection.js" asp-append-version="true"></script>
    <script src="~/js/TagTree_Toggle.js" asp-append-version="true"></script>
    <script src="~/js/TagTree_Search.js" asp-append-version="true"></script>

    <script src="~/js/DocMatrix.js" asp-append-version="true"></script>
    <script src="~/js/DocMatrix_TagChanges.js" asp-append-version="true"></script>
    <script src="~/js/DocMatrix_DocChanges.js" asp-append-version="true"></script>
    <script src="~/js/DocMatrix_Search.js" asp-append-version="true"></script>
    <script src="~/js/DocMatrix_Preview.js" asp-append-version="true"></script>
    <script src="~/js/DocMatrix_Document.js" asp-append-version="true"></script>
    <script src="~/js/DocMatrix_Navigation.js" asp-append-version="true"></script>
    <script src="~/js/DocMatrix_Print.js" asp-append-version="true"></script>
    <script src="~/js/DocMatrix_PrintEdit.js" asp-append-version="true"></script>
    
    <script src="~/js/Doc.js" asp-append-version="true"></script>
    <script src="~/js/Doc_CRUD.js" asp-append-version="true"></script>
    <script src="~/js/Doc_Viewer.js" asp-append-version="true"></script>
    <script src="~/js/Doc_ViewerCode.js" asp-append-version="true"></script>
    <script src="~/js/Doc_Editor.js" asp-append-version="true"></script>
    <script src="~/js/Doc_EditorList.js" asp-append-version="true"></script>
    <script src="~/js/Doc_EditorFormat.js" asp-append-version="true"></script>
    <script src="~/js/Doc_Toolbar.js" asp-append-version="true"></script>
    <script src="~/js/Doc_Reorder.js" asp-append-version="true"></script>
    <script src="~/js/Doc_Images.js" asp-append-version="true"></script>

    <script src="~/js/Explorer.js" asp-append-version="true"></script>
    <script src="~/js/Explorer_Resize.js" asp-append-version="true"></script>
    <script src="~/js/Explorer_Documents.js" asp-append-version="true"></script>
    <script src="~/js/Explorer_Navigation.js" asp-append-version="true"></script>
    <script src="~/js/Explorer_SoftHover.js" asp-append-version="true"></script>
    
    <script src="~/js/Domain.js" asp-append-version="true"></script>
    <script src="~/js/Domain_Explorer.js" asp-append-version="true"></script>
    <script src="~/js/Domain_Options.js" asp-append-version="true"></script>

    <script src="~/lib/signalr/signalr.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/Print.js" asp-append-version="true"></script>
    <script src="~/js/SoftHover.js" asp-append-version="true"></script>
    <script src="~/js/Lang.js" asp-append-version="true"></script>
    <script src="~/js/Lang/US.js" asp-append-version="true"></script>
    <script src="~/js/Lang/UA.js" asp-append-version="true"></script>

    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white">
        &copy; 2026 - MicroDoc
    </footer>
    @await RenderSectionAsync("Scripts", required: false)

    <script type="text/javascript">
        InitLanguage();

        LocalizeElement(document.querySelector("header"));

        (async function() {
            // setup SignalR connection
            const connection = new signalR.HubConnectionBuilder()
            .withUrl("/changeHub")
            .withAutomaticReconnect()
            .build();

            // setup changes callback
            connection.on("Changes", data => {
                if (clientUID != data.clientUID)
                {
                    data.changes.forEach(change => change.external = true);
                    window.domain.PublishChanges(data.changes);
                }
            });

            // connect SignalR
            await connection.start();
        })();
    </script>

</body>
</html>
