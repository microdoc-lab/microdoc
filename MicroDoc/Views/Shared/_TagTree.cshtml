@model TagTreeViewModel

<div id="@Model.Id" class="tag-tree">
    <ul class="module tag-list">
    @foreach (var module in Model.Nodes)
    {
        <li class="module tag" style="--tag-color:@module.Color;" data-path="@module.Path" data-tag="@module.Tag" data-id="@module.Id">
            <details class="@(!module.Children.Any() ? "empty" : "")">
                <summary class="title-bar">
                    <span class="module title">[@module.Tag]</span>
                </summary>

                @if (module.Children.Any())
                {
                    <ul class="process tag-list popup">
                        @foreach (var process in module.Children)
                        {
                            <li class="process tag" style="--tag-color:@process.Color" data-path="@process.Path" data-tag="@process.Tag" data-id="@process.Id">
                                <details class="@(!process.Children.Any() ? "empty" : "")">
                                    <summary class="title-bar">
                                        <span class="process title">[@process.Tag]</span>
                                    </summary>
                                    <ul class="step tag-list popup">
                                        @foreach (var step in process.Children)
                                        {
                                            <li class="step tag" style="--tag-color:@step.Color" data-path="@step.Path" data-tag="@step.Tag" data-id="@step.Id">
                                                <div class="title-bar">
                                                    <span class="step title">[@step.Tag]</span>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            </li>
                        }
                    </ul>
                }
            </details>
        </li>
    }
    </ul>
</div>

<script>
    (function() {
        const container = document.getElementById("@Model.Id");
        if (!container) return;

        const options = window["@Model.Id" + "Options"]

        const tree = new TagTree(container, options);

        @if (!string.IsNullOrEmpty(Model.SelectedNode))
        {
            <text>
            tree.SelectNode("@Model.SelectedNode");
            </text>
        }

        window["@Model.Id"] = tree;
        container.tagTree = tree;
    })();
</script>