@model TagTreeViewModel

@if (string.IsNullOrWhiteSpace(Model.Id))
{
    throw new ArgumentNullException();
}

@functions {
    bool IsTagNodeOpen(string tagId)
    {
        return !string.IsNullOrEmpty(Model.SelectedTag) 
            && Model.SelectedTag.StartsWith(tagId + "/");
    }
}

@{
    ViewData["SelectedTag"] = Model.SelectedTag;
}

<div id="@Model.Id" class="tag-tree">

    <style class="search-style"></style>

    <div class="toolbar">
        <button class="icon-button w new" onclick='document.getElementById("@Model.Id").tagTree.NewTag()' data-loc-title="TagTree_New">
            <img src="/icons/New.png">
        </button>
        <button class="icon-button w rename" onclick='document.getElementById("@Model.Id").tagTree.RenameTag()' data-loc-title="TagTree_Rename">
            <img src="/icons/Edit.png">
        </button>
        <button class="icon-button w delete" onclick='document.getElementById("@Model.Id").tagTree.DeleteTag()' data-loc-title="TagTree_Delete">
            <img src="/icons/Delete.png">
        </button>
        <button class="icon-button r reload" onclick='document.getElementById("@Model.Id").tagTree.Reload()' data-loc-title="TagTree_Reload">
            <img src="/icons/Refresh.png">
        </button>
        <button class="icon-button r search-ph">
            <img src="/icons/Search.png">
        </button>
    </div>

    <div class="domain tag @(Model.SelectedTag == "" ? "selected" : "")" data-domain="@Model.Domain.Name" data-tagid="" data-tag="" data-id="">
        <span class="title-bar">
            <span class="title">@Model.Domain.Name</span>
        </span>
    </div>

    <input class="r search" name="search" type="text" data-loc-placeholder="TagTree_SearchPH" data-loc-title="TagTree_Search"></input>

    <ul class="module tag-list">
    @foreach (var module in Model.Nodes)
    {
        ViewData["PartType"] = "module";
        @await Html.PartialAsync("_TagTreePart", module)
    }
    </ul>
</div>

<script>
    (function() {
        const container = document.getElementById("@Html.Raw(Model.Id)");
        if (!container) return;

        var options = window["@Html.Raw(Model.Id)" + "Options"]
		if (!options)
			window["@Html.Raw(Model.Id)" + "Options"] = options = {};

        const tagTree = GetInstanceOrCreate(container.parentElement, () => new TagTree(container, options));
        tagTree.domain = "@Html.Raw(Model.Domain.Name)";
        tagTree.selectedTag = "@Html.Raw(Model.SelectedTag)";

        tagTree.UpdateElement(container);
        tagTree.InitBehaviors();

        LocalizeElement(container.querySelector(".toolbar"));
        LocalizeElement(container.querySelector(".search"));
    })();
</script>