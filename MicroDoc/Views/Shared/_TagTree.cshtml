@model TagTreeViewModel

@if (string.IsNullOrWhiteSpace(Model.Id))
{
    throw new ArgumentNullException();
}

@functions {
    bool IsTagNodeOpen(string tagId)
    {
        return !string.IsNullOrEmpty(Model.SelectedTag) 
            && (Model.SelectedTag == tagId || Model.SelectedTag.StartsWith(tagId + "/"));
    }
}

<div id="@Model.Id" class="tag-tree">
	<div class="toolbar">
		<button class="icon-button" onclick='document.getElementById("@Model.Id").tagTree.New()' title="New Tag">
			<img src="/icons/New.png">
		</button>
		<button class="icon-button" onclick='document.getElementById("@Model.Id").tagTree.Reload()' title="Reload">
			<img src="/icons/Refresh.png">
		</button>
	</div>

    <ul class="module tag-list">
    @foreach (var module in Model.Nodes)
    {
        <li class="module tag @(module.Id == Model.SelectedTag ? "selected" : "")" 
            style="--tag-color:@module.Color;" 
            data-domain="@module.Domain" data-path="@module.Path" data-tag="@module.Tag" data-id="@module.Id">
            <details class="@(!module.Children.Any() ? "empty" : "")" open="@(module.Children.Any() && IsTagNodeOpen(module.Id))">
                <summary class="title-bar">
                    <span class="module title">[@module.Tag]</span>
                </summary>

                @if (module.Children.Any())
                {
                    <ul class="component tag-list popup">
                        @foreach (var component in module.Children)
                        {
                            <li class="component tag @(component.Id == Model.SelectedTag ? "selected" : "")" 
                                style="--tag-color:@component.Color" 
                                data-domain="@component.Domain" data-path="@component.Path" data-tag="@component.Tag" data-id="@component.Id">
                                <details class="@(!component.Children.Any() ? "empty" : "")" open="@(component.Children.Any() && IsTagNodeOpen(component.Id))">
                                    <summary class="title-bar">
                                        <span class="component title">[@component.Tag]</span>
                                    </summary>
                                    <ul class="part tag-list popup">
                                        @foreach (var part in component.Children)
                                        {
                                            <li class="part tag @(part.Id == Model.SelectedTag ? "selected" : "")" 
                                                style="--tag-color:@part.Color" 
                                                data-domain="@part.Domain" data-path="@part.Path" data-tag="@part.Tag" data-id="@part.Id">
                                                <div class="title-bar">
                                                    <span class="part title">[@part.Tag]</span>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            </li>
                        }
                    </ul>
                }
            </details>
        </li>
    }
    </ul>
</div>

<script>
    (function() {
        const container = document.getElementById("@Model.Id");
        if (!container) return;

        var options = window["@Model.Id" + "Options"]
		if (!options)
			window["@Model.Id" + "Options"] = options = {};

        const tagTree = new TagTree(container, options);
        tagTree.domain = "@Model.Domain.Name";
        tagTree.selectedTag = "@Model.SelectedTag";

        tagTree.InitBehaviors();
    })();
</script>