@model TagTreeViewModel

<div id="@Model.Id" class="tag-tree-container">
    <ul class="tag-tree">
    @foreach (var module in Model.Nodes)
    {
        <li class="module" style="--tag-color:@module.Color">
            <details class="@(!module.Children.Any() ? "empty" : "")">
                <summary class="tree-node-wrapper">
                    <span class="module-name tree-node" data-tag="@module.Path" draggable="true">[@module.Tag]</span>
                    <div class="toolbar" data-path="" data-tag="@module.Tag">
                    </div>
                </summary>

                @if (module.Children.Any())
                {
                    <ul class="process-list popup-content">
                        @foreach (var process in module.Children)
                        {
                            <li class="process" style="--tag-color:@process.Color">
                                <details class="@(!process.Children.Any() ? "empty" : "")">
                                    <summary class="tree-node-wrapper">
                                        <span class="process-name tree-node" data-tag="@process.Path" draggable="true">[@process.Tag]</span>
                                        <div class="toolbar" data-path="@module.Path" data-tag="@process.Tag">
                                        </div>
                                    </summary>
                                    <ul class="step-list popup-content">
                                        @foreach (var step in process.Children)
                                        {
                                            <li class="step" style="--tag-color:@step.Color">
                                                <div class="tree-node-wrapper">
                                                    <span class="step-name tree-node" data-tag="@step.Path" draggable="true">[@step.Tag]</span>
                                                    <div class="toolbar" data-path="@process.Path" data-tag="@step.Tag">
                                                    </div>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            </li>
                        }
                    </ul>
                }
            </details>
        </li>
    }
    </ul>
</div>

<script>
    (function() {
        const container = document.getElementById("@Model.Id");
        if (!container) return;

        const tree = new TagTree(container);

        @if (!string.IsNullOrEmpty(Model.SelectedNode))
        {
            <text>
            tree.selectNode("@Model.SelectedNode");
            </text>
        }

        window["@Model.Id"] = tree;
        container.tagTree = tree;
    })();
</script>