@model TagTreeViewModel

@if (string.IsNullOrWhiteSpace(Model.Id))
{
    throw new ArgumentNullException();
}

@functions {
    bool IsTagNodeOpen(string tagId)
    {
        return !string.IsNullOrEmpty(Model.SelectedTag) 
            && Model.SelectedTag.StartsWith(tagId + "/");
    }
}

@{
    ViewData["SelectedTag"] = Model.SelectedTag; 
}

<div id="@Model.Id" class="tag-tree">

    <style class="search-style"></style>

    <div class="tag-toolbar">
        <button class="icon-button w" onclick='document.getElementById("@Model.Id").tagTree.NewTag()' data-loc-title="TagTree_New">
            <img src="/icons/New.png">
        </button>
        <button class="icon-button w" onclick='document.getElementById("@Model.Id").tagTree.RenameTag()' data-loc-title="TagTree_Rename">
            <img src="/icons/Edit.png">
        </button>
        <button class="icon-button w" onclick='document.getElementById("@Model.Id").tagTree.DeleteTag()' data-loc-title="TagTree_Delete">
            <img src="/icons/Delete.png">
        </button>
    </div>

    <div class="toolbar-container">
	    <div class="toolbar">
		    <button class="icon-button r" onclick='document.getElementById("@Model.Id").tagTree.Reload()' data-loc-title="TagTree_Reload">
			    <img src="/icons/Refresh.png">
		    </button>
	    </div>

        <input class="search r" name="search" type="text" data-loc-placeholder="TagTree_SearchPH" data-loc-title="TagTree_Search"></input>
    </div>

    <div class="domain tag @(Model.SelectedTag == "" ? "selected" : "")" data-domain="@Model.Domain.Name" data-tagid="" data-tag="" data-id="">
        <span class="title-bar">
            <span class="domain title">@Model.Domain.Name</span>
        </span>
    </div>

    <ul class="module tag-list">
    @foreach (var module in Model.Nodes)
    {
        <li class="module tag @(module.Id == Model.SelectedTag ? "selected" : "")" 
            style="--tag-color:@module.Color;" 
            data-domain="@module.Domain" data-tagid="@module.TagId" data-tag="@module.Tag" data-id="@module.Id">
            <details class="@(!module.Children.Any() ? "empty" : "")" open="@(module.Children.Any() && IsTagNodeOpen(module.Id))">
                <summary class="title-bar">
                    <span class="module title" data-tag="@module.Tag">[@module.Tag]</span>
                </summary>

                @if (module.Children.Any())
                {
                    <ul class="component tag-list popup">
                        @foreach (var component in module.Children)
                        {
                            <li class="component tag @(component.Id == Model.SelectedTag ? "selected" : "")" 
                                style="--tag-color:@component.Color" 
                                data-domain="@component.Domain" data-tagid="@component.TagId" data-tag="@component.Tag" data-id="@component.Id">
                                <details class="@(!component.Children.Any() ? "empty" : "")" open="@(component.Children.Any() && IsTagNodeOpen(component.Id))">
                                    <summary class="title-bar">
                                        <span class="component title" data-tag="@component.Tag">[@component.Tag]</span>
                                    </summary>
                                    <ul class="part tag-list popup">
                                        @foreach (var part in component.Children)
                                        {
                                            @await Html.PartialAsync("_TagTreePart", part)
                                        }
                                    </ul>
                                </details>
                            </li>
                        }
                    </ul>
                }
            </details>
        </li>
    }
    </ul>
</div>

<script>
    (function() {
        const container = document.getElementById("@Html.Raw(Model.Id)");
        if (!container) return;

        var options = window["@Html.Raw(Model.Id)" + "Options"]
		if (!options)
			window["@Html.Raw(Model.Id)" + "Options"] = options = {};

        const tagTree = GetInstanceOrCreate(container.parentElement, () => new TagTree(container, options));
        tagTree.domain = "@Html.Raw(Model.Domain.Name)";
        tagTree.selectedTag = "@Html.Raw(Model.SelectedTag)";

        tagTree.UpdateElement(container);
        tagTree.InitBehaviors();

        LocalizeElement(container.querySelector(".toolbar-container"));
    })();
</script>