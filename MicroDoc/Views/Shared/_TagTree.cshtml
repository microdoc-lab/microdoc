@model TagTreeViewModel

<div id="@Model.Id" class="tag-tree-container">
    <ul class="tag-tree">
    @foreach (var module in Model.Nodes)
    {
        <li class="module" style="--tag-color:@module.Color">
            <div class="tree-node-wrapper">
                <span class="module-name tree-node" data-tag="@module.Id" draggable="true">@module.DisplayName</span>
                <div class="reorder-buttons" data-path="" data-group="@module.Group" data-tag="@module.Name">
                    <button type="button" data-dir="up">↑</button>
                    <button type="button" data-dir="down">↓</button>
                </div>
            </div>
            @if (module.Children.Any())
            {
                <ul class="process-list">
                    @foreach (var process in module.Children)
                    {
                        <li class="process">
                            <details>
                                <summary class="process-name tree-node-wrapper">
                                    <span class="process-name tree-node" data-tag="@process.Id" draggable="true">@process.DisplayName</span>
                                    <div class="reorder-buttons" data-path="@module.Id" data-group="@process.Group" data-tag="@process.Name">
                                        <button type="button" data-dir="up">↑</button>
                                        <button type="button" data-dir="down">↓</button>
                                    </div>
                                </summary>
                                <ul class="step-list">
                                    @foreach (var step in process.Children)
                                    {
                                        <li>
                                            <div class="tree-node-wrapper">
                                                <span class="step-name tree-node" data-tag="@step.Id" draggable="true">@step.DisplayName</span>
                                                <div class="reorder-buttons" data-path="@process.Id" data-group="@step.Group" data-tag="@step.Name">
                                                    <button type="button" data-dir="up">↑</button>
                                                    <button type="button" data-dir="down">↓</button>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </details>
                        </li>
                    }
                </ul>
            }
        </li>
    }
    </ul>
</div>

<script>
    (function() {
        const container = document.getElementById("@Model.Id");
        if (!container) return;

        const tree = new TagTree(container);

        @if (!string.IsNullOrEmpty(Model.SelectedNode))
        {
            <text>
            tree.selectNode("@Model.SelectedNode");
            </text>
        }

        window["@Model.Id"] = tree;
        container.tagTree = tree;
    })();
</script>