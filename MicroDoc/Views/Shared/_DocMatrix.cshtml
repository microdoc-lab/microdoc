@model DocMatrixViewModel

@if (string.IsNullOrWhiteSpace(Model.Id))
{
    throw new ArgumentNullException();
}

<div id="@Model.Id" class="docmatrix">
	<button onclick='document.getElementById("@Model.Id").docMatrix.Reload()'>Reload</button>
	<table class="grid">
		<tr>
			<th>Tag</th>
			@foreach (var column in Model.Domain.Documents)
			{
				<th>@column</th>	
			}
		</tr>

		@foreach (var row in Model.Rows)
		{
			<tr>
				<th>@row.Tag</th>
				@foreach (var column in Model.Domain.Documents)
				{
					var doc = row.Documents.FirstOrDefault(d => d.Name == column);
					if (doc == null)
					{
						doc = new MicroDoc.Services.DocNode
						{
							Domain = Model.Domain.Name,
							Path = row.Id,
							Name = column,
							Extension = ".txt",
							Content = string.Empty
						};
					}

					<td data-domain="@doc.Domain" data-id="@doc.Id" data-content="@doc.Content">@doc.Content</td>
				}
			</tr>
		}
	</table>
</div>

<script>
    (function() {
        const container = document.getElementById("@Model.Id");
        if (!container) return;

        var options = window["@Model.Id" + "Options"]
		if (!options)
			window["@Model.Id" + "Options"] = options = {};

        const docMatrix = new DocMatrix(container, options);
		docMatrix.domain = "@Model.Domain.Name";
		docMatrix.selectedTag = "@Model.SelectedTag";

		docMatrix.InitBehaviors();
    })();
</script>