@using MicroDoc.Services
@inject DomainOptions _domainOptions
@model DocMatrixViewModel

@if (string.IsNullOrWhiteSpace(Model.Id))
{
    throw new ArgumentNullException();
}

@{
	var columnDocuments = User.GridColumnDocuments(_domainOptions, Model.Domain.Name);
	int colWidth = 100 / (columnDocuments.Length + 2);
}

<div id="@Model.Id" class="docmatrix">
	<style class="search-style"></style>
	<table class="grid">
		<tr>
			<th style="width: @(colWidth)%; max-width: @(colWidth)%;">
				<div class="toolbar">
					<button class="icon-button r" onclick='document.getElementById("@Model.Id").docMatrix.Reload()' title="Reload">
						<img src="/icons/Refresh.png">
					</button>
					<button class="icon-button r" onclick='document.getElementById("@Model.Id").docMatrix.MoveTagUp()' title="Up">
						<img src="/icons/Up.png">
					</button>
					<input type="checkbox" class="load-deep-levels" @(Model.LoadDeepLevels ? "checked" : "") title="Load deep levels"
						onchange='document.getElementById("@Model.Id").docMatrix.LoadDeepLevelsChanged()' />
				</div>
				<input type="text" class="search r" placeholder="Search" />
			</th>
			@foreach (var column in columnDocuments)
			{
				var title = Model.Domain.DocumentOptions.FirstOrDefault(d => d.Name == @column)?.Title;
				<th style="width: @(colWidth)%; max-width: @(colWidth)%;" data-document="@column" title="@title">
					<div class="toolbar">
						<button class="icon-button r" onclick='document.getElementById("@Model.Id").docMatrix.OpenPrintColumn("@column")' title="Print">
							<img src="/icons/Print.png">
						</button>
					</div>
					@column
					<input type="text" class="search r" placeholder="Search" />
				</th>
			}
			<th class="misc" style="width: @(colWidth)%; max-width: @(colWidth)%;">
				<input type="text" class="search r" placeholder="Search" />
			</th>
		</tr>

		@foreach (var row in Model.Rows)
		{
			<tr data-tag="@row.Id">
				@if (row.IsDomain)
				{
					<th data-tag-level="@row.Level" style="--tag-level:@row.Level;"><clip><tag data-id="@row.Id">@Model.Domain.Name</tag></clip></th>
				}
				else
				{
					<th data-tag-level="@row.Level" style="--tag-level:@row.Level;"><clip><tag data-id="@row.Id">[@row.Tag]</tag></clip></th>
				}
				@foreach (var column in columnDocuments)
				{
					var doc = row.Documents.FirstOrDefault(d => d.Name == column);
					if (doc == null)
					{
						doc = new MicroDoc.Services.DocNode
						{
							Domain = Model.Domain.Name,
							Path = row.Id,
							Name = column,
							Extension = ".txt",
							Content = string.Empty,
							Html = string.Empty
						};
					}

					<td data-document="@column"><clip><doc class="preview" data-domain="@doc.Domain" data-tagpath="@row.TagPath" data-id="@doc.Id" data-document="@column" data-content="@doc.Content">@Html.Raw(doc.Html)</doc></clip></td>
				}
				<td class="misc"><clip>
					@foreach (var doc in row.Documents.Where(d => !columnDocuments.Contains(d.Name)).Where(d => User.IsInRole(_domainOptions, "r", Model.Domain.Name, d.Id)))
					{
						<doc class="preview" data-domain="@doc.Domain" data-tagpath="@row.TagPath" data-id="@doc.Id" data-content="@doc.Content" data-document="@doc.Name" data-name="@(doc.Name + doc.Extension)">@Html.Raw(doc.Html)</doc>
					}
				</clip></td>
			</tr>
		}
	</table>
</div>

<script>
    (function() {
        const container = document.getElementById("@Html.Raw(Model.Id)");
        if (!container) return;

        var options = window["@Html.Raw(Model.Id)" + "Options"]
		if (!options)
			window["@Html.Raw(Model.Id)" + "Options"] = options = {};

		const docMatrix = GetInstanceOrCreate(container.parentElement, () => new DocMatrix(container, options));
		docMatrix.domain = "@Html.Raw(Model.Domain.Name)";
		docMatrix.selectedTag = "@Html.Raw(Model.SelectedTag)";
		docMatrix.loadDeepLevels = @Model.LoadDeepLevels.ToString().ToLower();

		docMatrix.UpdateElement(container);
		docMatrix.InitBehaviors();
    })();
</script>

<style type="text/css">
	@foreach (var docOptions in Model.Domain.DocumentOptions)
	{
		if (!string.IsNullOrWhiteSpace(docOptions.Color))
		{
<text>.explorer[data-domain="@Html.Raw(Model.Domain.Name)"] .docmatrix th[data-document="@Html.Raw(docOptions.Name)"],
.explorer[data-domain="@Html.Raw(Model.Domain.Name)"] .docmatrix td.misc doc[data-document="@Html.Raw(docOptions.Name)"]::before,
.explorer[data-domain="@Html.Raw(Model.Domain.Name)"] .docmatrix td a[data-document="@Html.Raw(docOptions.Name)"],
.explorer[data-domain="@Html.Raw(Model.Domain.Name)"] .overlay .doc[data-document="@Html.Raw(docOptions.Name)"] .label,
.explorer[data-domain="@Html.Raw(Model.Domain.Name)"] .modal .toolbar .title[data-document="@Html.Raw(docOptions.Name)"],
.explorer[data-domain="@Html.Raw(Model.Domain.Name)"] .overlay .doc a[data-document="@Html.Raw(docOptions.Name)"] { background: @docOptions.Color; }
</text>
		}
	}
</style>