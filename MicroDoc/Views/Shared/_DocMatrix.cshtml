@model DocMatrixViewModel

@if (string.IsNullOrWhiteSpace(Model.Id))
{
    throw new ArgumentNullException();
}

@{
	int colWidth = 100 / (Model.Domain.Documents.Count + 2);
}

<div id="@Model.Id" class="docmatrix">
	<table class="grid">
		<tr>
			<th style="width: @(colWidth)%; max-width: @(colWidth)%;">
				<div class="toolbar">
					<button class="icon-button" onclick='document.getElementById("@Model.Id").docMatrix.Reload()' title="Reload">
						<img src="/icons/Refresh.png">
					</button>
					<button class="icon-button" onclick='document.getElementById("@Model.Id").docMatrix.MoveTagUp()' title="Up">
						<img src="/icons/Up.png">
					</button>
				</div>
			</th>
			@foreach (var column in Model.Domain.Documents)
			{
				<th style="width: @(colWidth)%; max-width: @(colWidth)%;" data-document="@column">@column</th>	
			}
			<th style="width: @(colWidth)%; max-width: @(colWidth)%;"></th>
		</tr>

		@foreach (var row in Model.Rows)
		{
			<tr data-tag="@row.Id">
				@if (row.IsDomain)
				{
					<th style="--tag-level:@row.Level;"><clip><tag data-id="@row.Id">@Model.Domain.Name</tag></clip></th>
				}
				else
				{
					<th style="--tag-level:@row.Level;"><clip><tag data-id="@row.Id">[@row.Tag]</tag></clip></th>
				}
				@foreach (var column in Model.Domain.Documents)
				{
					var doc = row.Documents.FirstOrDefault(d => d.Name == column);
					if (doc == null)
					{
						doc = new MicroDoc.Services.DocNode
						{
							Domain = Model.Domain.Name,
							Path = row.Id,
							Name = column,
							Extension = ".txt",
							Content = string.Empty,
							Html = string.Empty
						};
					}

					<td><clip><doc data-domain="@doc.Domain" data-id="@doc.Id" data-content="@doc.Content">@Html.Raw(doc.Html)</doc></clip></td>
				}
				<td class="misc"><clip>
					@foreach (var doc in row.Documents.Where(d => !Model.Domain.Documents.Contains(d.Name)))
					{
						<doc data-domain="@doc.Domain" data-id="@doc.Id" data-content="@doc.Content" data-document="@doc.Name" data-name="@(doc.Name + doc.Extension)">@Html.Raw(doc.Html)</doc>
					}
				</clip></td>
			</tr>
		}
	</table>
</div>

<script>
    (function() {
        const container = document.getElementById("@Model.Id");
        if (!container) return;

        var options = window["@Model.Id" + "Options"]
		if (!options)
			window["@Model.Id" + "Options"] = options = {};

        const docMatrix = new DocMatrix(container, options);
		docMatrix.domain = "@Model.Domain.Name";
		docMatrix.selectedTag = "@Model.SelectedTag";

		docMatrix.InitBehaviors();
    })();
</script>

<style type="text/css">
	@foreach (var docOptions in Model.Domain.DocumentOptions)
	{
		if (!string.IsNullOrWhiteSpace(docOptions.Color))
		{
<text>.explorer[data-domain="@Model.Domain.Name"] .docmatrix th[data-document=@docOptions.Name],
.explorer[data-domain="@Model.Domain.Name"] .docmatrix td.misc doc[data-document=@docOptions.Name]::before,
.explorer[data-domain="@Model.Domain.Name"] .docmatrix td a[data-document=@docOptions.Name],
.explorer[data-domain="@Model.Domain.Name"] .overlay .doc[data-document=@docOptions.Name]::before,
.explorer[data-domain="@Model.Domain.Name"] .overlay .doc a[data-document=@docOptions.Name] { background: @docOptions.Color; }
</text>
		}
	}
</style>