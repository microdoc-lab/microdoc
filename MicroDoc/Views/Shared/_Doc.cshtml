@model DocViewModel

@if (string.IsNullOrWhiteSpace(Model.Id))
{
    throw new ArgumentNullException();
}

<div id="@Model.Id" class="doc" mode="@Model.Mode" 
    data-domain="@Model.Doc.Domain" data-id="@Model.Doc.Id" data-tagpath="@Model.Doc.TagPath" data-document="@Model.Doc.Name" data-content="@Model.Doc.Content">
    <span class="label" data-loc-title="Document_Copy">@Model.Doc.TagPath</span>
    <div class="viewer">@Html.Raw(Model.Doc.Html)</div>
    <textarea class="editor">@Model.Doc.Content</textarea>
</div>

<script>
    (function() {
        const container = document.getElementById("@Html.Raw(Model.Id)");
        if (!container) return;

        var options = window["@Html.Raw(Model.Id)" + "Options"]
		if (!options)
			window["@Html.Raw(Model.Id)" + "Options"] = options = {};

        const doc = GetInstanceOrCreate(container.parentElement, () => new Doc(container, options));
		doc.domain = "@Html.Raw(Model.Domain.Name)";
		doc.documentId = "@Html.Raw(Model.Doc.Domain)";

        doc.UpdateElement(container);
		doc.InitBehaviors();

        LocalizeElement(container.querySelector(".label"));
    })();
</script>