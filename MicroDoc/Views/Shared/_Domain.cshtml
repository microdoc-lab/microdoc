@using MicroDoc.Services
@inject DomainOptions _domainOptions

<div id="domainExplorers"></div>

<div id="domainOptions" style="display: none;">
	<textarea class="editor"></textarea>
</div>

<script>
    var options = {};

    options.DomainBackgroundVersions = {};
    @foreach (var docOptions in _domainOptions.Domains)
	{
<text>options.DomainBackgroundVersions["@docOptions.Name"] = "@docOptions.GetBackgroundVersion()";
</text>
	}

    var domain = new Domain(options);
    
    domain.InitBehaviors();

    domain.OpenExplorer("microdoc.doc", "Services");
</script>