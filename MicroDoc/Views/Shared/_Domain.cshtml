@using MicroDoc.Services
@inject DomainOptions _domainOptions

<div id="domainExplorers">
    @if (!User.Identity.IsAuthenticated)
    {
        <h1>Welcome to MicroDoc</h1>
        <br/>
        <h3>Please, login</h3>
    }
</div>

<div id="domainOptions" style="display: none;">
	<textarea class="editor"></textarea>
</div>

<script>
    var options = {};

    options.domainBackgroundVersions = {};
    @foreach (var domainOptions in _domainOptions.Domains)
	{
<text>options.domainBackgroundVersions["@Html.Raw(domainOptions.Name)"] = "@domainOptions.BackgroundVersion";
</text>
	}

    var domain = new Domain(options);
    
    domain.InitBehaviors();

    @if (User.Identity.IsAuthenticated)
    {
        var domain = _domainOptions.Domains.FirstOrDefault(d => User.IsInRole(d.Name + ":" + "r"));
        if (domain != null)
        {
<text>domain.OpenExplorer("@Html.Raw(domain.Name)");
</text>
        }
    }
</script>