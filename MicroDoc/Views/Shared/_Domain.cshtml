@using MicroDoc.Services
@inject DomainOptions _domainOptions

@{
    Model.Id = "domainExplorers";
}

<div id="@Model.Id">
    <div class="landing-page">
        <h1>Welcome to MicroDoc</h1>
        <p>
            Library of well-organized tiny documents
        </p>
        <div class="feature-grid">
            <!-- first row: no no no -->
            <div class="feature-card blue">
                <h2>No database No cloud</h2>
                <p>File-system document storage. No database roundtrips. Local deployment. Fast performance</p>
            </div>

            <div class="feature-card green">
                <h2>No document identifiers</h2>
                <p>Document naming like file-system:<br/><b>[Admin] [Player] vision.txt</b><br/><b>[Admin] [Player] use-cases.txt</b></p>
            </div>

            <div class="feature-card orange">
                <h2>No huge documents</h2>
                <p>Split monolith document on topics (rows - tags) and details (columns - vision/architecture/use-cases)</p>
            </div>

            <!-- second row: matrix -->
            <div class="feature-card purple">
                <h2>Document Matrix</h2>
                <p>View contents of whole document system (topic and it's parts). Edit multiple documents</p>
            </div>

            <div class="feature-card pink">
                <h2>Document preview</h2>
                <p>Fast preview document sections/images from matrix, navigate to section on click</p>
            </div>

            <div class="feature-card teal">
                <h2>Achieve completeness</h2>
                <p>Analyze document matrix, fill gaps by adding missed information into cells</p>
            </div>

            <!-- third row: domain -->
            <div class="feature-card peach">
                <h2>Build domain onthology</h2>
                <p>Define tag hierarchy representing domain modules/components/parts</p>
            </div>

            <div class="feature-card olive">
                <h2>Multiple domain support</h2>
                <p>Configure multiple domains (software development, music lessons, car repair, home renovation) with it's own set of columns, background</p>
            </div>

            <div class="feature-card misty-blue">
                <h2>Domain level security</h2>
                <p>Configure user roles per domain (r - reader, w - writer).<br/>Google authentication supported</p>
            </div>

            <!-- fourth row -->
            <div class="feature-card blush-pink">
                <h2>Simplified markdown</h2>
                <p>Headings/Lists/Images/Tables/Links support</p>
            </div>

            <div class="feature-card sage">
                <h2>Reactive updates</h2>
                <p>SignalR updates immediately reflect changes made by others (tags, documents)</p>
            </div>

            <div class="feature-card butter">
                <h2>Open source</h2>
                <p>Lightweight codebase, minimum external components, MIT licence, easy for extension</p>
            </div>
        </div>
    </div>
</div>

<div id="domainOptions" style="display: none;">
	<textarea class="editor"></textarea>
</div>

<script>
    (function() {
        const container = document.getElementById("@Html.Raw(Model.Id)");
        if (!container) return;

        var options = window["@Html.Raw(Model.Id)" + "Options"]
		if (!options)
			window["@Html.Raw(Model.Id)" + "Options"] = options = {};

        options.domainBackgroundVersions = {};
        @foreach (var domainOptions in _domainOptions.Domains)
	    {
<text>options.domainBackgroundVersions["@Html.Raw(domainOptions.Name)"] = "@domainOptions.BackgroundVersion";
</text>
	    }

        const domain = GetInstanceOrCreate(container.parentElement, () => new Domain(container, options));
    
        domain.UpdateElement(container);
        domain.InitBehaviors();

        @if (User.Identity.IsAuthenticated)
        {
            string domainToOpen = (string)ViewData["domain"];
            string documentIdToOpen = (string)ViewData["documentId"];

            var domain = _domainOptions.Domains
                .Where(d => domainToOpen == null || d.Name == domainToOpen)
                .FirstOrDefault(d => User.IsInRole(_domainOptions, "r", d.Name));
            if (domain != null)
            {
                if (documentIdToOpen != null)
                {
<text>domain.OpenExplorer("@Html.Raw(domain.Name)", "@Html.Raw(documentIdToOpen)");
</text>
                }
                else
                {
<text>domain.OpenExplorer("@Html.Raw(domain.Name)");
</text>
                }
            }
        }
    })();
</script>