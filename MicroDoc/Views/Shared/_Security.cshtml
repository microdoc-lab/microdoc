@using MicroDoc.Services
@using System.Security.Claims
@inject DomainOptions _domainOptions

@{
    string[] globalRoles = new[] { "r", "w", "a" };
    string[] domainRoles = new[] { "r", "w" };
}

<style type="text/css">
    @foreach (var role in globalRoles)
    {
    <text>.@role { display: @(Context.User.IsInRole(role) ? "revert" : "none") !important; }
    </text>
    }

    @if (_domainOptions.DomainLevelSecurity)
    {
        @foreach (var domain in _domainOptions.Domains)
        @foreach (var role in domainRoles)
        {
            var domainCss = domain.Name.Replace(".", "\\.");
            var display = Context.User.IsInRole(_domainOptions, role, domain.Name) ? "revert" : "none";

    <text>.explorer.@Html.Raw(domainCss) .@role { display: @display !important; }
    </text>
        }

        @foreach (var domain in _domainOptions.Domains.Where(d => d.DocumentLevelSecurity))
        @foreach (var document in domain.KnownDocuments())
        @foreach (var role in domainRoles)
        {
            var domainCss = domain.Name.Replace(".", "\\.");
            var display = Context.User.IsInRole(_domainOptions, role, domain.Name, document) ? "revert" : "none";

    <text>.explorer.@Html.Raw(domainCss) .toolbar[data-document="@Html.Raw(document)"] .@role { display: @display !important; }
    </text>
        }
    }
</style>

<script type="text/javascript">
    var roles = [];
    
    @foreach (var role in Context.User.Claims.Where(c => c.Type == ClaimTypes.Role))
    {
        <text>roles.push("@role.Value");
        </text>
    }

    function isInRole(role, domain, documentId) {
        if (domain && @_domainOptions.DomainLevelSecurity.ToString().ToLower())
        {
    @foreach (var domain in _domainOptions.Domains.Where(d => d.DocumentLevelSecurity))
    {
        <text>
            if (documentId && domain == "@domain.Name")
            {
                var knownDocuments = [ @Html.Raw(string.Join(", ", domain.KnownDocuments().Select(d => $"\"{d}\""))) ];
                var docName = DocParser.DocName(documentId);
                if (knownDocuments.includes(docName))
                    return roles.includes(`${domain}:${docName}:${role}`);
            }
        </text>
    }

            return roles.includes(`${domain}:${role}`);
        }   
        return roles.includes(role);
    }
</script>