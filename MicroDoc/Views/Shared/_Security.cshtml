@using MicroDoc.Services
@inject DomainOptions _domainOptions

@{
    string[] globalRoles = new[] { "a" };
    string[] domainRoles = new[] { "r", "w" };
}

<style type="text/css">
    @foreach (var role in globalRoles)
    {
    <text>.@role { display: @(Context.User.IsInRole(role) ? "revert" : "none") !important; }
    </text>
    }

    @foreach (var domain in _domainOptions.Domains)
    @foreach (var role in domainRoles)
    {
    <text>.explorer.@Html.Raw(domain.Name.Replace(".", "\\.")) .@role { display: @(Context.User.IsInRole(_domainOptions, role, domain.Name) ? "revert" : "none") !important; }
    </text>
    }
</style>

<script type="text/javascript">
    var roles = [];

    @foreach (var role in globalRoles)
    {
        if (Context.User.IsInRole(role))
        {
        <text>roles.push("@role");
        </text>
        }
    }

    @foreach (var domain in _domainOptions.Domains)
    @foreach (var role in domainRoles)
    {
        if (Context.User.IsInRole(_domainOptions, role, domain.Name))
        {
        <text>roles.push("@Html.Raw(domain.Name + ":" + role)");
        </text>
        }
    }

    function isInRole(role, domain) {
        if (!domain)
            return roles.includes(role);

    @if (_domainOptions.DomainLevelSecurity)
    {
        <text>return roles.includes(domain + ":" + role);</text>
    }
    else
    {
        <text>return roles.includes(role);</text>
    }
    }
</script>