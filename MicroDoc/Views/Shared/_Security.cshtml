@using MicroDoc.Services
@inject DomainOptions _domainOptions

@{
    string[] globalRoles = new[] { "r", "w", "a" };
    string[] domainRoles = new[] { "r", "w" };
}

<style type="text/css">
    @foreach (var role in globalRoles)
    {
    <text>.@role { display: @(Context.User.IsInRole(role) ? "revert" : "none") !important; }
    </text>
    }

    @foreach (var domain in _domainOptions.Domains)
    @foreach (var role in domainRoles)
    {
    <text>.@Html.Raw(domain.Name.Replace(".", "\\.")) .@role { display: @(Context.User.IsInRole(domain.Name + ":" + role) ? "revert" : "none") !important; }
    </text>
    }
</style>

<script type="text/javascript">
    var roles = [];

    @foreach (var role in globalRoles)
    {
        if (Context.User.IsInRole(role))
        {
        <text>roles.push("@role");
        </text>
        }
    }

    @foreach (var domain in _domainOptions.Domains)
    @foreach (var role in domainRoles)
    {
        if (Context.User.IsInRole(domain.Name + ":" + role))
        {
        <text>roles.push("@Html.Raw(domain.Name + ":" + role)");
        </text>
        }
    }

    function isInGlobalRole(role) {
        return roles.includes(role);
    }

    function isInRole(domain, role) {
        return roles.includes(domain + ":" + role);
    }
</script>