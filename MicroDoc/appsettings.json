{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },

    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    },

    "File": {
      "BasePath": "Logs",
      "FileAccessMode": "KeepOpenAndAutoFlush",
      "FileEncodingName": "utf-8",
      "DateFormat": "yyyyMMdd",
      "CounterFormat": "000",
      "Files": [
        {
          "Path": "app-<date>.log"
        }
      ],
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },

  "Urls": "https://localhost:7273",
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": "%ClientId%",
      "ClientSecret": "%ClientSecret%"
    }
  },
  "MicroDoc": {
    "DomainOptions": "~/DomainOptions.ini"
  }
}
